{
  "name": "@virentia/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Fine-grained reactive JSX components for Virentia",
  "license": "MIT",
  "author": "movpushmov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virentia-labs/virentia.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": ["./dist/start/cli.mjs", "./dist/start/cli.cjs"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.mts",
      "import": "./dist/jsx-dev-runtime.mjs",
      "require": "./dist/jsx-dev-runtime.cjs"
    },
    "./start": {
      "types": "./dist/start/index.d.mts",
      "import": "./dist/start/index.mjs",
      "require": "./dist/start/index.cjs"
    },
    "./start/vite": {
      "types": "./dist/start/vite.d.mts",
      "import": "./dist/start/vite.mjs",
      "require": "./dist/start/vite.cjs"
    },
    "./start/node": {
      "types": "./dist/start/node.d.mts",
      "import": "./dist/start/node.mjs",
      "require": "./dist/start/node.cjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "node": {
        "import": "./dist/react/server.mjs",
        "require": "./dist/react/server.cjs"
      },
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./react/server": {
      "types": "./dist/react/server.d.mts",
      "import": "./dist/react/server.mjs",
      "require": "./dist/react/server.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.mts",
      "node": {
        "import": "./dist/vue/server.mjs",
        "require": "./dist/vue/server.cjs"
      },
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.cjs"
    },
    "./vue/server": {
      "types": "./dist/vue/server.d.mts",
      "import": "./dist/vue/server.mjs",
      "require": "./dist/vue/server.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    }
  },
  "scripts": {
    "dev": "vite --config examples/playground/vite.config.ts",
    "ssr:dev": "vite --config examples/ssr/vite.config.ts",
    "start:dev": "vite --config examples/start/vite.config.ts",
    "start:build": "node dist/start/cli.mjs build --root examples/start",
    "start:serve": "node dist/start/cli.mjs serve --root examples/start",
    "playground:build": "vite build --config examples/playground/vite.config.ts",
    "embedded:dev": "vite --config examples/embedded/vite.config.ts",
    "embedded:build": "vite build --config examples/embedded/vite.config.ts",
    "build": "tsdown",
    "test": "vitest run && tsc --noEmit -p tsconfig.vitest.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.vitest.json"
  },
  "bin": {
    "virentia-start": "./dist/start/cli.mjs"
  },
  "dependencies": {
    "@virentia/core": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@virentia/mutable": "workspace:*",
    "@virentia/react": "workspace:*",
    "@virentia/vue": "workspace:*",
    "happy-dom": "^20.0.10",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vue": "^3.5.13",
    "vite": "^8.0.12"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0",
    "@virentia/react": "^0.5.2",
    "@virentia/vue": "^0.5.2",
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.5",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "@virentia/react": {
      "optional": true
    },
    "@virentia/vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
