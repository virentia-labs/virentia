{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@virentia/core": ["packages/core/lib/index.ts"],
      "@virentia/core/compiler": ["packages/core/compiler/index.ts"],
      "@virentia/core/compiler/vite": ["packages/core/compiler/vite.ts"],
      "@virentia/core/devtools": ["packages/core/lib/devtools.ts"],
      "@virentia/core/internal": ["packages/core/lib/internal.ts"],
      "@virentia/core/models": ["packages/core/lib/models.ts"],
      "@virentia/core/utils": ["packages/core/lib/utils.ts"],
      "@virentia/effector": ["packages/effector/lib/index.ts"],
      "@virentia/inspector": ["packages/inspector/lib/index.ts"],
      "@virentia/inspector/effector": ["packages/inspector/lib/effector/index.ts"],
      "@virentia/mutable": ["packages/mutable/lib/index.ts"],
      "@virentia/react": ["packages/react/lib/index.ts"],
      "@virentia/ui": ["packages/ui/lib/index.ts"],
      "@virentia/ui/server": ["packages/ui/lib/server.ts"],
      "@virentia/ui/jsx-runtime": ["packages/ui/lib/jsx-runtime.ts"],
      "@virentia/ui/jsx-dev-runtime": ["packages/ui/lib/jsx-dev-runtime.ts"],
      "@virentia/ui/vite": ["packages/ui/vite.ts"],
      "@virentia/ui/start": ["packages/ui/start/index.ts"],
      "@virentia/ui/start/vite": ["packages/ui/start/vite.ts"],
      "@virentia/ui/start/node": ["packages/ui/start/node.ts"],
      "@virentia/ui/react": ["packages/ui/lib/react.ts"],
      "@virentia/ui/react/server": ["packages/ui/lib/react-server.ts"],
      "@virentia/ui/vue": ["packages/ui/lib/vue.ts"],
      "@virentia/ui/vue/server": ["packages/ui/lib/vue-server.ts"],
      "@virentia/vue": ["packages/vue/lib/index.ts"]
    }
  },
  "include": [
    "packages/core/lib/**/*.ts",
    "packages/core/tests/**/*.ts",
    "packages/core/tsdown.config.ts",
    "packages/effector/lib/**/*.ts",
    "packages/effector/tests/**/*.ts",
    "packages/effector/tsdown.config.ts",
    "packages/inspector/lib/**/*.ts",
    "packages/inspector/lib/**/*.tsx",
    "packages/inspector/tests/**/*.ts",
    "packages/inspector/tsdown.config.ts",
    "packages/inspector/vite.config.ts",
    "packages/mutable/lib/**/*.ts",
    "packages/mutable/tests/**/*.ts",
    "packages/mutable/tsdown.config.ts",
    "packages/react/lib/**/*.ts",
    "packages/react/tests/**/*.ts",
    "packages/react/tsdown.config.ts",
    "packages/ui/lib/**/*.ts",
    "packages/ui/vite.ts",
    "packages/ui/tests/**/*.ts",
    "packages/ui/tests/**/*.tsx",
    "packages/ui/tsdown.config.ts",
    "packages/vue/lib/**/*.ts",
    "packages/vue/tests/**/*.ts",
    "packages/vue/tsdown.config.ts"
  ]
}
